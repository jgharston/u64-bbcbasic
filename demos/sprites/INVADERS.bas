10 REM INVADERS: sprites over graphics (MODE 132, VIC-II MODE 4)
20 REM Three rows of 8 invaders and a ship, each in its own band: never
30 REM more than 8 sprites on a line, and at most 2 shapes in a band
40 REM (the bitmap leaves room for 2: the multiplexer copies them in).
50 *SPRITE ON
60 MODE 132
70 PROCshapes
80 PROCscenery
90 PROCsetup
100 REPEAT
110   PROCframe
120 UNTIL FALSE
130 END
140 DEF PROCshapes
150   PROCdefine(0,"0C00C00C00C00303000303000FFFC00FFFC03CFCF03CFCF0FFFFFCFFFFFCCFF","FCCCFFFCCCC00CCCC00CC03CF0003CF00000000000000000000000000000000")
160   PROCdefine(1,"0C00C00C00C0C3030CC3030CCFFFCCCFFFCCFCFCFCFCFCFCFFFFFCFFFFFC3FF","FF03FFFF00C00C00C00C0300030300030000000000000000000000000000000")
170   PROCdefine(2,"00300000300000FC0000FC0000FC0000FC003FFFF03FFFF0FFFFFCFFFFFCFFF","FFCFFFFFCFFFFFCFFFFFCFFFFFCFFFFFC000000000000000000000000000000")
180 ENDPROC
190 DEF PROCdefine(S%,A$,B$)
200   OSCLI "SPRITE DEFINE "+STR$S%+" "+A$+B$
210 ENDPROC
220 DEF PROCscenery
230   LOCAL I%
240   GCOL 0,1
250   FOR I%=1 TO 60
260     PLOT 69,RND(1280)-1,200+RND(820)
270   NEXT
290   MOVE 0,30:DRAW 1279,30
300   COLOUR 1:PRINT TAB(13,0);"U64 INVADERS"
310 ENDPROC
320 DEF PROCsetup
325   REM H%,V%: the formation (X% and Y% belong to OSWORD)
330   DIM B% 10
340   H%=100:V%=880:D%=8:F%=0:P%=0:T%=TIME
350   FOR N%=0 TO 23
360     B%?0=N%:B%?1=3:B%?6=VAL MID$("136",1+N% DIV 8,1):PROCword
370   NEXT
380   B%?0=24:B%?1=2:B%?6=2:PROCword
390   B%?1=3:B%?6=2:PROCword
400 ENDPROC
410 DEF PROCframe
420   LOCAL N%
430   FOR N%=0 TO 23
440     B%?0=N%:B%?1=1:B%!2=H%+(N% MOD 8)*130:B%!4=V%-(N% DIV 8)*160:PROCword
450   NEXT
460   H%=H%+D%
470   IF H%<0 OR H%>270 THEN D%=-D%:H%=H%+D%:V%=V%-16
480   IF V%<560 THEN V%=880
490   F%=F%+1
500   IF F% MOD 12=0 THEN PROCanimate
510   P%=P%+1
520   B%?0=24:B%?1=1:B%!2=592+INT(560*SIN(P%/40)):B%!4=50:PROCword
530   REPEAT UNTIL TIME>T%+1
540   T%=TIME
550 ENDPROC
560 DEF PROCanimate
570   LOCAL N%
580   FOR N%=0 TO 23
590     B%?0=N%:B%?1=2:B%?6=(F% DIV 12) MOD 2:PROCword
600   NEXT
610 ENDPROC
620 DEF PROCword
630   A%=&71:X%=B% MOD 256:Y%=B% DIV 256:CALL &C7F1
640 ENDPROC
