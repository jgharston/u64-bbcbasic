10 REM INVADERS: a small game with multiplexed sprites (MODE 132, VIC-II
20 REM MODE 4). Keys: Z / X or cursor left / right move, SPACE or RETURN
30 REM fires; or a joystick in port 2. RUN/STOP: back to the title.
40 REM Three rows of 8 invaders and the ship in bands of their own: never
50 REM more than 8 sprites on a line, at most 2 shapes in a band (the
60 REM bitmap leaves room for 2): the shot and the bomb share one shape.
70 REM Sound: SID mode's instruments (SNARE, KICK, BASS), flushed.
80 *SPRITE ON
90 MODE 132
100 ON ERROR PROCerror
110 DIM B% 10,A%(23),C%(7)
120 PROCshapes
130 HI%=0
140 PROCplay
180 END
190 :
200 REM Shapes: 0, 1 invader (two frames), 2 the ship, 3 the shot/bomb
210 DEF PROCshapes
220   PROCdefine(0,"0C00C00C00C00303000303000FFFC00FFFC03CFCF03CFCF0FFFFFCFFFFFCCFF","FCCCFFFCCCC00CCCC00CC03CF0003CF00000000000000000000000000000000")
230   PROCdefine(1,"0C00C00C00C0C3030CC3030CCFFFCCCFFFCCFCFCFCFCFCFCFFFFFCFFFFFC3FF","FF03FFFF00C00C00C00C0300030300030000000000000000000000000000000")
240   PROCdefine(2,"00300000300000FC0000FC0000FC0000FC003FFFF03FFFF0FFFFFCFFFFFCFFF","FFCFFFFFCFFFFFCFFFFFCFFFFFCFFFFFC000000000000000000000000000000")
250   PROCdefine(3,STRING$(8,"001800"),STRING$(13,"000000"))
260 ENDPROC
270 DEF PROCdefine(S%,A$,B$)
280   OSCLI "SPRITE DEFINE "+STR$S%+" "+A$+B$
290 ENDPROC
300 :
400 REM The title: stars, the name, the keys, the high score
410 DEF PROCtitle
420   LOCAL I%,K%
430   PROCallhide
440   CLG:CLS
450   GCOL 0,1
460   FOR I%=1 TO 60
470     PLOT 69,RND(1280)-1,200+RND(820)
480   NEXT
490   MOVE 0,30:DRAW 1279,30
500   COLOUR 1
510   PRINT TAB(14,5);"U64 INVADERS"
520   PRINT TAB(8,9);"Z X or cursor: move"
530   PRINT TAB(8,10);"SPACE or RETURN: fire"
540   PRINT TAB(8,11);"or a joystick in port 2"
550   PRINT TAB(8,14);"High score ";HI%
560   PRINT TAB(8,17);"SPACE or FIRE: play"
570   PRINT TAB(8,18);"Q: quit"
580   *FX 15,1
590   REPEAT
600     K%=INKEY(5)
610     IF K%=81 OR K%=113 THEN PROCquit(0)
620   UNTIL K%=32 OR (ADVAL(0) AND 1)
630 ENDPROC
640 :
700 REM One game: levels until the lives are gone or the invaders land
710 DEF PROCgame
720   SC%=0:LI%=3:LV%=1
730   CLG:CLS
740   GCOL 0,1:MOVE 0,30:DRAW 1279,30
750   REPEAT
760     PROClevel
770     IF LI%>0 AND NOT LAND% THEN LV%=LV%+1
780   UNTIL LI%=0 OR LAND%
790   PROCallhide
800   PRINT TAB(15,12);"GAME OVER"
810   IF SC%>HI% THEN HI%=SC%:PRINT TAB(11,14);"A new high score!"
820   SOUND &1002,7+256*12,1,20
830   T%=TIME+300:REPEAT UNTIL TIME>T%
840 ENDPROC
850 :
900 REM A level: the formation, then frames until it is cleared or over
910 DEF PROClevel
920   LOCAL N%
930   FOR N%=0 TO 23:A%(N%)=1:NEXT
940   FOR N%=0 TO 7:C%(N%)=3:NEXT
950   AL%=24:H%=100:V%=880-32*((LV%-1) MOD 4):D%=8+2*(LV%-1):LAND%=FALSE
960   SX%=592:BU%=FALSE:BO%=FALSE:FR%=0:ST%=0:MR%=0
970   FOR N%=0 TO 23
980     B%?0=N%:B%?1=2:B%?6=0:PROCword
990     B%?0=N%:B%?1=3:B%?6=VAL MID$("136",1+N% DIV 8,1):PROCword
1000   NEXT
1010   B%?0=24:B%?1=2:B%?6=2:PROCword
1020   B%?1=3:B%?6=5:PROCword
1030   B%?0=25:B%?1=2:B%?6=3:PROCword
1040   B%?1=3:B%?6=1:PROCword
1050   B%?0=26:B%?1=2:B%?6=3:PROCword
1060   B%?1=3:B%?6=7:PROCword
1070   PROCformation
1080   PROCstatus
1090   T%=TIME
1100   REPEAT
1110     PROCship
1120     PROCshot
1130     PROCbomb
1140     FR%=FR%+1
1150     IF FR%>=1+AL% DIV 3 THEN FR%=0:PROCstep
1160     REPEAT UNTIL TIME>T%+1
1170     T%=TIME
1180   UNTIL AL%=0 OR LI%=0 OR LAND%
1190 ENDPROC
1200 :
1300 REM The ship: keys or joystick, 16 units a frame; fire starts a shot
1310 DEF PROCship
1320   LOCAL J%
1330   J%=ADVAL(1)
1340   IF INKEY(-98) OR INKEY(-26) OR J%>40000 THEN SX%=SX%-16
1350   IF INKEY(-67) OR INKEY(-122) OR J%<20000 THEN SX%=SX%+16
1360   IF SX%<0 THEN SX%=0
1370   IF SX%>1184 THEN SX%=1184
1380   B%?0=24:B%?1=1:B%!2=SX%:B%!4=40:PROCword
1390   IF BU% THEN ENDPROC
1400   IF INKEY(-99) OR INKEY(-74) OR (ADVAL(0) AND 1) THEN PROCfire
1410 ENDPROC
1420 DEF PROCfire
1430   BU%=TRUE:BX%=SX%+44:BY%=140
1440   SOUND &1000,12+256*10,180,1
1450 ENDPROC
1460 :
1500 REM The shot: up 32 a frame; an invader it reaches is gone
1510 DEF PROCshot
1520   LOCAL C%,R%,N%,W%
1530   IF NOT BU% THEN ENDPROC
1540   BY%=BY%+32
1550   IF BY%>1000 THEN BU%=FALSE:B%?0=25:B%?1=0:PROCword:ENDPROC
1560   B%?0=25:B%?1=1:B%!2=BX%:B%!4=BY%:PROCword
1570   IF BX%<H% THEN ENDPROC
1580   C%=(BX%-H%) DIV 130
1590   IF C%>7 OR (BX%-H%) MOD 130>=96 THEN ENDPROC
1600   FOR R%=0 TO 2
1610     W%=V%-R%*160
1620     N%=R%*8+C%
1630     IF A%(N%) AND BY%+40>=W% AND BY%<=W%+84 THEN PROChit(N%):R%=2
1640   NEXT
1650 ENDPROC
1660 DEF PROChit(N%)
1670   A%(N%)=0:AL%=AL%-1:C%(N% MOD 8)=C%(N% MOD 8)-1
1680   B%?0=N%:B%?1=0:PROCword
1690   BU%=FALSE:B%?0=25:B%?1=0:PROCword
1700   SC%=SC%+10*(3-N% DIV 8)*LV%
1710   SOUND &1001,11+256*14,60,2
1720   PROCstatus
1730 ENDPROC
1740 :
1800 REM The bomb: one at a time, from a random invader of the lowest row
1810 REM still standing in its column; down 20 a frame
1820 DEF PROCbomb
1830   LOCAL C%,R%,N%
1840   IF NOT BO% THEN PROCdrop:ENDPROC
1850   OY%=OY%-20
1860   IF OY%<30 THEN BO%=FALSE:B%?0=26:B%?1=0:PROCword:ENDPROC
1870   B%?0=26:B%?1=1:B%!2=OX%:B%!4=OY%:PROCword
1880   IF OY%<150 AND OX%+8>=SX% AND OX%<=SX%+88 THEN PROCkilled
1890 ENDPROC
1900 DEF PROCdrop
1910   LOCAL C%,R%
1920   IF RND(20)>1+LV% THEN ENDPROC
1930   C%=RND(8)-1
1940   IF C%(C%)=0 THEN ENDPROC
1950   R%=2
1960   REPEAT
1970     IF A%(R%*8+C%)=0 THEN R%=R%-1
1980   UNTIL R%<0 OR A%(R%*8+C%)
1990   IF R%<0 THEN ENDPROC
2000   BO%=TRUE:OX%=H%+C%*130+44:OY%=V%-R%*160-20
2010 ENDPROC
2020 DEF PROCkilled
2030   LOCAL I%
2040   BO%=FALSE:B%?0=26:B%?1=0:PROCword
2050   LI%=LI%-1:PROCstatus
2060   SOUND &1002,11+256*15,20,10
2070   FOR I%=1 TO 6
2080     B%?0=24:B%?1=3:B%?6=2+5*(I% MOD 2):PROCword
2090     T%=TIME+10:REPEAT UNTIL TIME>T%
2100   NEXT
2105   B%?0=24:B%?1=3:B%?6=5:PROCword
2110 ENDPROC
2120 :
2200 REM One step of the formation: sideways; at an edge down and back.
2210 REM The edges are the outer columns still standing. A march note too.
2220 DEF PROCstep
2230   LOCAL L%,R%
2235   IF AL%=0 THEN ENDPROC
2240   L%=0:REPEAT IF C%(L%)=0 THEN L%=L%+1
2250   UNTIL L%>7 OR C%(L%)>0
2260   R%=7:REPEAT IF C%(R%)=0 THEN R%=R%-1
2270   UNTIL R%<0 OR C%(R%)>0
2280   H%=H%+D%
2290   IF H%+L%*130<0 OR H%+R%*130>1184 THEN D%=-D%:H%=H%+D%:V%=V%-32
2300   IF V%-2*160<180 THEN LAND%=TRUE
2310   PROCformation
2320   MR%=(MR%+1) MOD 4
2330   SOUND &1003,7+256*12,VAL MID$("33302925",MR%*2+1,2),1
2340 ENDPROC
2350 DEF PROCformation
2360   LOCAL N%
2370   ST%=1-ST%
2380   FOR N%=0 TO 23
2390     IF A%(N%) THEN B%?0=N%:B%?1=1:B%!2=H%+(N% MOD 8)*130:B%!4=V%-(N% DIV 8)*160:PROCword:B%?1=2:B%?6=ST%:PROCword
2400   NEXT
2410 ENDPROC
2420 :
2500 DEF PROCstatus
2510   COLOUR 1
2520   PRINT TAB(0,0);"SCORE ";SC%;"  LIVES ";LI%;"  LEVEL ";LV%;"  HI ";HI%;"  ";
2530 ENDPROC
2540 :
2600 DEF PROCallhide
2610   LOCAL N%
2620   FOR N%=0 TO 26
2630     B%?0=N%:B%?1=0:PROCword
2640   NEXT
2650 ENDPROC
2660 :
2700 REM OSWORD &71: B%?0 sprite, ?1 action (0 hide, 1 at !2,!4, 2 shape
2710 REM ?6, 3 colour ?6); X% and Y% carry the block's address
2720 DEF PROCword
2730   A%=&71:X%=B% MOD 256:Y%=B% DIV 256:CALL &C7F1
2740 ENDPROC
2750 :
2800 REM Title and games for ever (Q on the title quits); RUN/STOP comes
2810 REM back here through ON ERROR (it clears BASIC's stack)
2820 DEF PROCplay
2830   REPEAT
2840     PROCtitle
2850     PROCgame
2860   UNTIL FALSE
2870 ENDPROC
2880 DEF PROCerror
2890   IF ERR<>17 THEN PROCquit(ERR)
2900   PROCplay
2910 ENDPROC
2920 DEF PROCquit(E%)
2930   *SPRITE OFF
2940   IF E%<>0 THEN REPORT:PRINT " at line ";ERL
2950   END
2960 ENDPROC
