10 REM SHOW4: 32 multiplexed sprites (*SPRITE) over the text screen,
20 REM while the 8 SIDs play
25 MODE 100
30 *SPRITE ON
40 MODE 100
50 *OFF
55 *FX 15,1
57 ON ERROR OSCLI "SPRITE OFF":OSCLI "SONG STOP":OSCLI "MODSTOP":VDU 4:IF ERR=17 END ELSE REPORT:PRINT " at line ";ERL:END
60 PROCshape
70 PROCsetup
80 COLOUR 7
90 PRINT TAB(9,11);"32 sprites on 8"
100 PRINT TAB(9,13);"24 voices on 8 SIDs"
110 E%=TIME+1500
120 REPEAT
130   PROCmove
140 UNTIL TIME>E% OR INKEY(0)<>-1
150 *SPRITE OFF
160 CHAIN "SHOW5"
170 END
180 :
200 DEF PROCshape
210   LOCAL S$
220   S$="00FF0003FFC007FFE01FFFF81FFFF83FFFFC7FFFFE7FFFFE7FFFFE7FFFFEFFF"
230   S$=S$+"FFF7FFFFE7FFFFE7FFFFE7FFFFE3FFFFC1FFFF81FFFF807FFE003FFC000FF00"
240   OSCLI "SPRITE DEFINE 0 "+S$
250 ENDPROC
260 :
300 REM Four bands of 8 (never more than 8 on a line), as demos/sprites
310 DEF PROCsetup
320   DIM X%(31),Y%(31),U%(31),V%(31),L%(31),H%(31),B% 10
330   FOR N%=0 TO 31
340     L%(N%)=(N% DIV 8)*256+8:H%(N%)=L%(N%)+130
350     X%(N%)=RND(1180):Y%(N%)=L%(N%)+RND(130)
360     U%(N%)=RND(17)-9:V%(N%)=RND(9)-5
370     IF V%(N%)=0 THEN V%(N%)=3
380     B%?0=N%:B%?1=3:B%?6=1+((N% DIV 8)*4+N% MOD 4) MOD 15:PROCword
390   NEXT
400 ENDPROC
410 :
500 DEF PROCmove
510   LOCAL T%
520   T%=TIME
530   FOR N%=0 TO 31
540     X%(N%)=X%(N%)+U%(N%):Y%(N%)=Y%(N%)+V%(N%)
550     IF X%(N%)<0 THEN X%(N%)=0:U%(N%)=ABS U%(N%)
560     IF X%(N%)>1180 THEN X%(N%)=1180:U%(N%)=-ABS U%(N%)
570     IF Y%(N%)<L%(N%) THEN Y%(N%)=L%(N%):V%(N%)=ABS V%(N%)
580     IF Y%(N%)>H%(N%) THEN Y%(N%)=H%(N%):V%(N%)=-ABS V%(N%)
590     B%?0=N%:B%?1=1:B%!2=X%(N%):B%!4=Y%(N%):PROCword
600   NEXT
610   REPEAT UNTIL TIME>T%
620 ENDPROC
630 :
700 DEF PROCword
710   A%=&71:X%=B% MOD 256:Y%=B% DIV 256:CALL &C7F1
720 ENDPROC
