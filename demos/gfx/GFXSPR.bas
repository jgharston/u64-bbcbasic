10 REM GFXSPR: VIC-II sprites (*SPRITE): 32 multiplexed over any
20 REM VIC-II mode; here MODE 132 (MODE 4 on the VIC-II) with drawing
30 REM behind them. More: demos/sprites (BALLS, INVADERS).
40 MODE 132
50 REM *SPRITE ON works in a VIC-II mode and, in a program, takes effect
60 REM at the next MODE (it lowers HIMEM)
70 *SPRITE ON
80 MODE 132
90 *OFF
100 PRINT "Sprites over graphics: 8 move, ESCAPE"
110 PRINT "or a key ends."
120 *CIRCLE FILL 640,500,300
130 *SPRITE DEFINE 0 00FF0003FFC007FFE01FFFF81FFFF83FFFFC7FFFFE7FFFFE7FFFFE7FFFFEFFFFFF7FFFFE7FFFFE7FFFFE7FFFFE3FFFFC1FFFF81FFFF807FFE003FFC000FF00
140 DIM B% 10
150 FOR N%=0 TO 7
160   B%?0=N%:B%?1=3:B%?6=N%+1:PROCword
170 NEXT
180 T=0
190 REPEAT
200   PROCmove
210 UNTIL INKEY(2)>=0
220 *SPRITE OFF
230 CHAIN "GFXDEMO"
240 END
250 DEF PROCmove
260   LOCAL N%
270   T=T+0.05
280   FOR N%=0 TO 7
290     B%?0=N%:B%?1=1
300     B%!2=600+450*SIN(T+N%*0.785):B%!4=480+300*COS(T*1.3+N%*0.785)
310     PROCword
320   NEXT
330 ENDPROC
340 DEF PROCword
350   A%=&71:X%=B% MOD 256:Y%=B% DIV 256:CALL &C7F1
360 ENDPROC
