10 REM GFXBBC: the BBC graphics modes, one test card each, drawn in
20 REM BBC units (1280 x 1024) so every mode shows the same picture.
30 REM On a 64 MHz U64 MODE 1, 2, 4 and 5 are Upic Lite (256 lines).
40 REM MODE at the top level: it moves HIMEM, which BASIC refuses
50 REM inside a PROC or loop ("Bad MODE").
60 MODE 1:PROCcard(1)
70 MODE 2:PROCcard(2)
80 MODE 4:PROCcard(4)
90 MODE 5:PROCcard(5)
100 CHAIN "GFXDEMO"
110 END
120 DEF PROCcard(M%)
130   LOCAL C%,I%,K%
140   *OFF
150   C%=4:IF M%=2 THEN C%=16 ELSE IF M%=4 THEN C%=2
160   PRINT "MODE ";M%;": ";C%;" colours"
170   PROCbars(C%)
180   PROCfan
190   PROCshapes
200   PROCpattern
210   PROCwindow
220   PROCtext
230   K%=GET
240 ENDPROC
250 DEF PROCbars(C%)
260   LOCAL I%
270   W%=1280 DIV C%
280   FOR I%=0 TO C%-1
290     GCOL 0,I%
300     A%=I%*W%
310     *RECTANGLE FILL A%,0,W%,80
320   NEXT
330 ENDPROC
340 DEF PROCfan
350   LOCAL I%
360   GCOL 0,FNc(1)
370   FOR I%=0 TO 16
380     E%=I%*40:F%=480
390     *LINE 0,880,E%,F%
400   NEXT
410 ENDPROC
420 DEF PROCshapes
430   GCOL 0,FNc(2)
440   *CIRCLE FILL 900,700,120
450   GCOL 0,FNc(3)
460   *ELLIPSE 900,700,200,80
470   *RECTANGLE 700,120,500,250
480   GCOL 0,FNc(1)
490   MOVE 100,150:MOVE 400,150:PLOT 85,250,400
500   GCOL 0,FNc(2)
510   *CIRCLE 520,250,60
520   PLOT 133,520,250
530 ENDPROC
540 DEF PROCpattern
550   GCOL 16,0
560   *RECTANGLE FILL 750,150,180,180
570   GCOL 3,3
580   *RECTANGLE FILL 850,200,250,100
590 ENDPROC
600 DEF PROCwindow
610   VDU 24,450;450;650;650;
620   GCOL 0,129:CLG
630   GCOL 0,FNc(2)
640   *CIRCLE FILL 550,550,150
650   VDU 26
660 ENDPROC
670 DEF PROCtext
680   VDU 23,240,24,60,126,255,255,126,60,24
690   GCOL 0,FNc(3)
700   MOVE 450,950:VDU 5:PRINT "VDU 5 ";CHR$240;:VDU 4
710   PRINT TAB(0,3);"POINT: ";POINT(900,700);" ";POINT(10,10)
720 ENDPROC
9990 DEF FNc(N%)
9991   REM colour N% within the mode's (2-colour MODE 4: always 1)
9992 =1+(N%-1) MOD (C%-1)
